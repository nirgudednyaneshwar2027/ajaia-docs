{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.5" },
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev:server": "node --disable-warning=ExperimentalWarning server/src/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "mammoth": "^1.8.0",
    "marked": "^14.0.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.13.0"
  }
}
